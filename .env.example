# Firebase Configuration
FIREBASE_STORAGE_BUCKET=dpo-frontend.firebasestorage.app
GOOGLE_APPLICATION_CREDENTIALS=/root/workspace/Inference-Microservice/serviceAccountKey.json

# Pinecone Configuration
PINECONE_API_KEY=your-pinecone-api-key-here

# Model Configuration
BASE_MODEL_NAME=lambdalabs/pythia-2.8b-deduped-synthetic-instruct

# Inference Parameters
MAX_NEW_TOKENS=50
TEMPERATURE=0.1
TOP_P=0.85
REPETITION_PENALTY=1.5
NO_REPEAT_NGRAM_SIZE=3

# DPO System Prompt (optional - used for Part 2: fine-tuned model without RAG)
# This helps the DPO-trained model show its capabilities
DPO_SYSTEM_PROMPT="You are a helpful, accurate, and polite assistant. Provide clear, well-structured answers that directly address the question.\n\n"

# Device Configuration
DEVICE=cuda
